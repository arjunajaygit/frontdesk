{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["jest", "node"],
    "rootDir": "..",
    "allowJs": false,
    "resolveJsonModule": true,
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": ["./**/*.ts", "../prisma/*.ts", "../src/*.d.mts"]
}
