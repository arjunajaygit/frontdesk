digraph { graph [bgcolor="white",pad="0.2",nodesep="0.3",ranksep="0.4"]; node [shape=box,style="rounded,filled",fillcolor="#eaf2f8",color="#41637d",fontname="DejaVu Sans",fontsize=10]; edge [color="#526777",fontname="DejaVu Sans",fontsize=9];rankdir=TB; Request->Auth->Begin; Begin->ConditionalUpdate; ConditionalUpdate->AuditInsert [label="one row"]; ConditionalUpdate->Rollback [label="zero rows"]; AuditInsert->Commit [label="success"]; AuditInsert->Rollback [label="failure"]; Commit->HTTP200; Rollback->HTTP409 [label="conflict only"]; Rollback->HTTP503 [label="DB failure"];}