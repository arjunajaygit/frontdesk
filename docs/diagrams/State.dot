digraph {graph [bgcolor="white",pad="0.2",nodesep="0.35",ranksep="0.45"]; node [shape=box,style="rounded,filled",fillcolor="#eaf2f8",color="#41637d",fontname="DejaVu Sans",fontsize=10]; edge [color="#526777",fontname="DejaVu Sans",fontsize=9]; rankdir=TB; OPEN->IN_PROGRESS [label="atomic claim"]; IN_PROGRESS->WAITING [label="public request"]; WAITING->IN_PROGRESS [label="reply <= cutoff"]; IN_PROGRESS->RESOLVED [label="resolve + response fulfilled"]; RESOLVED->IN_PROGRESS [label="eligible reopen, assigned"]; RESOLVED->OPEN [label="eligible reopen, unassigned"]; RESOLVED->CLOSED [label="now > reopenUntil"]; WAITING->CLOSED [label="now > inactivity cutoff"]; CLOSED->OPEN [style=dashed,label="new linked ticket"]; }
