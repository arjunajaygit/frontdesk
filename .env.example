# Copy to .env (git-ignored) via `npm run env:gen`, which generates all secrets. Never commit .env.
# Runtime connection: restricted, non-owner role.
DATABASE_URL=postgresql://frontdesk_app:REPLACE_ME@localhost:55432/frontdesk
# Migration/seed connection: schema owner role. Used only by tooling, never by the running API.
MIGRATION_DATABASE_URL=postgresql://frontdesk_owner:REPLACE_ME@localhost:55432/frontdesk
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
BUSINESS_TIMEZONE=Asia/Kolkata
# Exact canonical browser origin: scheme://host[:port], no trailing slash. HTTPS required in production.
PUBLIC_ORIGIN=http://localhost:5173
# Generate independently of JWT_SECRET (>=32 random bytes, hex/base64); placeholders are rejected at startup.
CSRF_SIGNING_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET

# Compose-only bootstrap values (local Postgres container). Generated by env:gen.
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_ME
FRONTDESK_OWNER_PASSWORD=REPLACE_ME
FRONTDESK_APP_PASSWORD=REPLACE_ME
